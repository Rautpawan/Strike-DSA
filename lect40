// };
ListNode* reverseList(ListNode* head) {
    ListNode* prev = NULL, *curr = head, *future = NULL;

	while(curr){
		future = curr->next;
		curr->next = prev;
		prev = curr;
		curr = future;
	}
	head = prev;
	return head;
}

//  Remove Nodes From Linked List
// Definition for singly-linked list.
