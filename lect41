// Doubly linked list 
// prev <- Data -> next

class Node{
	public:
	int value;
	Node *next;
	Node *prev;

	Node(int val){
		value = val;
		prev = next = NULL;
	}
};

void printDLL(Node *head){
	while(head){
		cout << head->value << " ";
		head = head->next;
	}
}

