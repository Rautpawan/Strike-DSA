// Reccursion
 void birthDay(int i){
        if(i==0){
            cout << "Happy Birthday";
            return;
        }
        cout << i << "days left for Birthday" << endl;;
        birthDay(i-1);
    }

    void Print(int num){
        if(num==0) return;
        cout << num << endl;
        Print(num-1);
    }

    void Number(int num , int n){
        if(num==n+1) return;
        cout << num <<" ";
        Number(num+1, n);
    }

    int Sum(int num ){
        if(num==0) return 0;

        return num+Sum(num-1);
    }

