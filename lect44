// Reverse the Array
void reverseArray(vector<int>& arr) {
    int n = arr.size();
	stack<int>s;

	for(int i=0; i<n; i++){
		s.push(arr[i]);
	}

	for(int i=0; i<n; i++){
		arr[i]=s.top();
		s.pop();
	}
}


// Insert an Element at the Bottom of a Stack
void insertAtBottom(stack<int>& st, int x) {
    stack<int>extra;
	while(!st.empty()){
		extra.push(st.top());
		st.pop();
	}
	st.push(x);
	while(!extra.empty()){
		st.push(extra.top());
		extra.pop();
	}
}

