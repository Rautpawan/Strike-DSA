// Stack using Array
class Stack{
    public:
    int arr[100];
    int index;

    Stack(){
        index = -1;
    }

    void push(int val){
        if(index==99){
            cout << "Stack Overflow\n";
        }
        else{
            index++;
            arr[index]=val;
            cout << val <<"pushed into stack \n";
        }
    }

    void pop(){
        if(index==-1){
            cout <<"stack is uderflow\n";
        }
        else{
            cout << arr[index] << "popped from stack \n";
            index--;
        }
    }

    int top(){
        return arr[index];
    }

    bool empty(){
        return index==-1;
    }

    int size(){
        return index+1;
    }
};

