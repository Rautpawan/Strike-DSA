// Stack using Linked List
class Node{
    public:
    int data;
    Node *next;

    Node(int val){
        data = val;
        next = NULL;
    }
};
class Stack{
    public:
    Node *index;
    int size;

    Stack(){
        index = NULL;
        size=0;
    }

    void push(int val){
        Node *temp = new Node(val);
        if(!temp){
            cout <<"Stack overflow";
            return;
        }
        temp->next = index;
        index=temp;
        size++;
        cout << val << "Pushed into stack \n";
    }

    void pop(){
        if(index==NULL){
            cout <<"Stack is Underflow";
        }
        else{
            cout << index->data <<"popped from the stack \n";
            Node *temp = index;
            index = index->next;
            delete temp;
            size--;
        }
    }

    int top(){
        return index->data;
    }
    int size(){
        return size;
    }
    bool empty(){
        return size==0;
    }
};

int main(){
    Stack s;
    s.push(10);
    s.push(20);
    s.push(30);
    s.size();
}



