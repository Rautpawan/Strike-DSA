        // code here
        if(st.empty()){
            long long a=x;
            st.push(a*1000000001+a);
        }
        else{
            long long a = x;
            long long minElement = st.top()%1000000001; 
            minElement = min(a,minElement);
            st.push(a*1000000001+minElement);
        }
