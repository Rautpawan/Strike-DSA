// Palindrome string 
bool palli(string &s, int start, int end){
	if(start>=end){
		return true;
	}
	if(s[start]!=s[end]){
		return false;
	}
	return palli(s, start+1, end-1);
}

bool isPalindrome(string& s) {
    // Your code here
	return palli(s,0,s.size()-1);
}

// Reverse a string 
void reverse(string &s, int start, int end){
	if(start>=end){
		return;
	}
	swap(s[start], s[end]);
	reverse(s, start+1, end-1);
}

string reverseString(string &s) {
    // Your code here
	reverse(s,0, s.size()-1);
	return s;
} 

// Liner Search
int find(vector<int>&arr, int target, int index, int n){
	if(index==n){
		return -1;
	}
	if(arr[index]==target){
		return index;
	}
	return find(arr, target, index+1, n);
}

int linearSearch(vector<int>& arr, int target) {
    //code here
	return find(arr, target, 0, arr.size());
}
