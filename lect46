// 109. Next Greater Element II
vector<int> nextLargerElement(vector<int>& arr) {
    stack<int>st;
    vector<int>ans(arr.size(),-1);

    for(int i=0; i<arr.size(); i++){
        while(!st.empty() && arr[i]>arr[st.top()]){
            ans[st.top()]=arr[i];
            st.pop();
        }
        st.push(i);
    }
    return ans;
}


