// 342. Queue Reversal
queue<int> reverseQueue(queue<int> q) {
    stack<int>s;
    while(!q.empty()){
        s.push(q.front());
        q.pop();
    }

    while(!s.empty()){
        q.push(s.top());
        s.pop();
    }

    return q;
}


// 343. Reverse first K of a Queue
class Solution {
public:
    queue<int> modifyQueue(queue<int> q, int k) {
        // Your code here
        if(k>q.size()){
            return q;
        }

        stack<int>s;

        for(int i=0; i<k; i++){
            s.push(q.front());
            q.pop();
        }

        while(!s.empty()){
            q.push(s.top());
            s.pop();
        }

        int totalElement = q.size()-k;
        while(totalElement){
            q.push(q.front());
            q.pop();
            totalElement--;
        }

        return q;
    }
};


// 223. Time Needed to Buy Tickets
int timeRequiredToBuy(vector<int>& tickets, int k) {
    int totalTime = 0;

    for(int i=0; i<=k; i++){
        totalTime += min(tickets[i],tickets[k]);
    }

    for(int i=k+1; i<tickets.size(); i++){
        totalTime += min(tickets[i],tickets[k]-1);
    }
    return totalTime;
}
